# =============================================================================
# RoomForge environment variables
# Copy to .env and fill in real values.
# NEVER put secrets in VITE_* variables (those are bundled into the frontend).
# =============================================================================

# --- Frontend (Vite) — only public values ---
# Leave empty in local dev to use Vite proxy (/api → localhost:3005)
VITE_BACKEND_URL=
# Public LiveKit WebSocket URL
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# --- LiveKit (server only) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Supabase (server only) ---
SUPABASE_URL=https://your-project.supabase.co
# Use the service_role JWT (Settings → API). Never use the anon key here.
SUPABASE_SERVICE_ROLE_KEY=

# --- App URLs ---
# Production example:
# FRONTEND_URL=https://roomforge.vercel.app
# BACKEND_URL=https://roomforge-api.onrender.com
# VITE_BACKEND_URL=https://roomforge-api.onrender.com
FRONTEND_URL=http://localhost:5177
BACKEND_URL=http://localhost:3005
# Optional comma-separated extra CORS origins
# ALLOWED_ORIGINS=https://roomforge.vercel.app

# --- Server ---
PORT=3005
NODE_ENV=development
# HOST_TOKEN_SECRET=   # min 32 chars; defaults from LIVEKIT_API_SECRET if unset
TOKEN_TTL_SECONDS=7200
MEETING_TTL_HOURS=24
# Password required in URL (?password=...) to unlock Create Room
CREATE_ACCESS_PASSWORD=inform8_roomforge
